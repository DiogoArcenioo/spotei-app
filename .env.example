EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_IA_MODE=gemini
# Opcional: outro endereço do servidor Expo; no desenvolvimento é automático.
EXPO_PUBLIC_IA_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: URL autorizada no painel Auth do Supabase.
EXPO_PUBLIC_RECOVERY_URL=

# Privadas: usadas somente pela rota de servidor, nunca pelo aplicativo.
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
